# PostgreSQL authentication database.
DATABASE_URL=postgresql://deep_agent:replace-with-a-long-random-password@127.0.0.1:5432/deep_agent
DATABASE_POOL_SIZE=10
# Set to require for a hosted PostgreSQL service.
DATABASE_SSL=disable
DATABASE_SSL_VERIFY=true

# Session lifetime. Users can be revoked immediately from the admin UI.
SESSION_TTL_HOURS=12

# LangGraph must be private in production; browsers connect through /api/langgraph.
LANGGRAPH_INTERNAL_URL=http://127.0.0.1:2024
LANGGRAPH_API_KEY=
NEXT_PUBLIC_MANAGED_AUTH=true
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=deep_agent

# Used only by `yarn auth:create-admin`; remove these after bootstrap.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Team Administrator
ADMIN_PASSWORD=replace-with-a-unique-temporary-password
